element {
    spacing: 10px;
    margin: 0px;
    padding: 10px;
    border: 0px solid;
    border-radius: 8px;
    background-color: transparent;
    text-color: #DADADA;
}

element normal.normal {
	background-color: transparent;
	text-color: #DADADA;
}

element alternate.normal {
	background-color: transparent;
	text-color: #DADADA;
}

element selected.active {
	background-color: transparent;
	text-color: #DADADA;
}

element selected.normal {
	background-color: #3F3F3F;
	text-color: #DADADA;
}
