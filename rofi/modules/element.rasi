configuration {
    drun-display-format: "{name}\n<span size='x-small' alpha='60%'>{comment}</span>";
}

element {
    orientation: horizontal;
    children: [ element-icon, element-text ];
    spacing: 8px;
    margin: 0px;
    padding: 6px 10px;
    border: 0px solid;
    border-radius: 8px;
    background-color: transparent;
    text-color: #DADADA;
}

element-icon {
    background-color: transparent;
    size: 1.8em;
    vertical-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    markup: true;
    expand: true;
    vertical-align: 0.5;
}

element normal.normal {
    background-color: transparent;
    text-color: #DADADA;
}

element alternate.normal {
    background-color: transparent;
    text-color: #DADADA;
}

element selected.active {
    background-color: transparent;
    text-color: #DADADA;
}

element selected.normal {
    background-color: #3F3F3F;
    text-color: #DADADA;
}

listview {
    fixed-height: false;
}
