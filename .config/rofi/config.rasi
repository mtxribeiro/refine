configuration {
    modi: "drun";
    show-icons: true;
    drun-display-format: "{name}\n<span size='x-small' alpha='60%'>{comment}</span>";
}

* {
    window-bg: #242424;
    view-bg: #1e1e1e;
    fg: #ffffff;
    fg-muted: #9a9996;
    accent: #ffffff;
    outline: #ffffff26;
    selection: #ffffff1f;
    font: "Noto Sans 12";
    highlight: bold #ffffff;
}

window {
    transparency: "real";
    location: north;
    y-offset: 100;
    width: 710px;
    padding: 12px;
    background-color: @window-bg;
    border: 1px;
    border-color: @outline;
    border-radius: 8px;
}

mainbox {
    children: ["inputbar", "listview", "message"];
    spacing: 10px;
    padding: 10px;
}

inputbar {
    children: ["entry"];
}

entry {
    placeholder: "  Digite para pesquisar...";
    placeholder-color: @fg-muted;
    text-color: @fg;
    background-color: @view-bg;
    padding: 8px;
    border: 1px;
    border-color: @accent;
    border-radius: 8px;
}

listview {
    lines: 6;
    fixed-height: false;
    scrollbar: false;
    border: 0px;
}

element {
    spacing: 8px;
    padding: 6px 10px;
    border: 0px;
    border-radius: 8px;
    background-color: transparent;
    text-color: @fg;
}

element-icon {
    size: 1.8em;
    background-color: transparent;
}

element-text {
    expand: true;
    markup: true;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element normal.active,
element alternate.active {
    background-color: transparent;
    text-color: @accent;
}

element selected.normal,
element selected.active {
    background-color: @selection;
    text-color: @fg;
}

message,
error-message,
textbox {
    background-color: transparent;
    text-color: @fg;
    border: 0px;
}
