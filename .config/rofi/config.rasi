// CONFIGURATION

configuration {
    modi: "drun";
    show-icons: true;
    drun-display-format: "{name}\n<span size='x-small' alpha='60%'>{comment}</span>";
}

// GLOBAL

* {
    window-bg:  #242424ff;
    view-bg:    #1e1e1eff;
    fg:         #ffffffff;
    fg-muted:   #9a9996ff;
    accent:     #ffffffff;
    outline:    #ffffff26;
    selection:  #ffffff1f;

    font:       "Noto Sans 12";
    highlight:  bold #ffffff;
}

// WINDOW

window {
    transparency: "real";
    location: north;
    y-offset: 100;
    width: 710px;
    padding: 12px;
    background-color: @window-bg;
    border: 1px solid;
    border-color: @outline;
    border-radius: 8px;
}

// MAINBOX

mainbox {
    children: ["inputbar", "listview", "message"];
    spacing: 10px;
    margin: 0px;
    padding: 10px;
}

// INPUTBAR

inputbar {
    children: ["entry"];
}

entry {
    placeholder: "  Digite para pesquisar...";
    placeholder-color: @fg-muted;
    text-color: @fg;
    background-color: @view-bg;
    padding: 8px;
    border: 1px;
    border-color: @accent;
    border-radius: 8px;
}

// LISTVIEW

listview {
    columns: 1;
    lines: 6;
    fixed-height: false;
    fixed-columns: true;
    cycle: true;
    scrollbar: false;
    require-input: false;
    border: 0px solid;
}

// ELEMENT

element {
    orientation: horizontal;
    children: [ "element-icon", "element-text" ];
    spacing: 8px;
    margin: 0px;
    padding: 6px 10px;
    border: 0px solid;
    border-radius: 8px;
    background-color: transparent;
    text-color: @fg;
}

element-icon {
    size: 1.8em;
    vertical-align: 0.5;
    background-color: transparent;
}

element-text {
    expand: true;
    markup: true;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element normal.active,
element alternate.active {
    background-color: transparent;
    text-color: @accent;
}

element selected.normal,
element selected.active {
    background-color: @selection;
    text-color: @fg;
}

// MESSAGE

message,
error-message,
textbox {
    background-color: transparent;
    text-color: @fg;
    border: 0px solid;
}
