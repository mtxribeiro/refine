 // CONFIGURATION

configuration {
    modi: "drun";
    show-icons: true;
    drun-display-format: "{name}\n<span size='x-small' alpha='60%'>{comment}</span>";
}

// GLOBAL

* {
    font: "Noto Sans 12";
    highlight: bold;
}

// WINDOW

window {
    transparency: "real";
    width: 710px;
    border-radius: 8px;
    background-color: #181818FF;
    border: 0px solid;
    padding: 12px;
    location: north;
    y-offset: 100;
}

// MAINBOX

mainbox {
    spacing: 10px;
    margin: 0px;
    padding: 10px;
    children: ["inputbar", "listview", "message"];
}

// INPUTBAR

inputbar {
    children: ["entry"];
    spacing: 10px;
}

// PROMPT

prompt {
    text-color: #C0C0C0FF;
}

// ENTRY

entry {
    placeholder: "  Digite para pesquisar...";
    text-color: #DADADA;
    background-color: #181818;
    padding: 8px;
    border-radius: 8px;
    border: 2px;
    border-color: #DADADA;
}

// LISTVIEW

listview {
    columns: 1;
    lines: 6;
    fixed-height: false;
    fixed-columns: true;
    cycle: false;
    scrollbar: false;
    border: 0px solid;
}

// ELEMENT

element {
    orientation: horizontal;
    children: [ element-icon, element-text ];
    spacing: 8px;
    margin: 0px;
    padding: 6px 10px;
    border: 0px solid;
    border-radius: 8px;
    background-color: transparent;
    text-color: #DADADA;
}

element-icon {
    background-color: transparent;
    size: 1.8em;
    vertical-align: 0.5;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    markup: true;
    expand: true;
    vertical-align: 0.5;
}

element normal.normal,
element alternate.normal,
element selected.active {
    background-color: transparent;
    text-color: #DADADA;
}

element selected.normal {
    background-color: #3F3F3F;
    text-color: #DADADA;
}

// MESSAGE

message,
error-message,
textbox {
    background-color: transparent;
    text-color: #FFFFFFFF;
    border: 0px solid;
}
