// ── CONFIGURATION ───────────────────────────────────────────────────────────

configuration {
    modi: "drun";
    show-icons: true;
    drun-display-format: "{name}\n<span size='x-small' alpha='60%'>{comment}</span>";
}

// ── GLOBAL ──────────────────────────────────────────────────────────────────

* {
    window-bg:  #242424FF;
    view-bg:    #1E1E1EFF;
    fg:         #FFFFFFFF;
    fg-muted:   #9A9996FF;
    accent:     #78AEEDFF;
    outline:    #FFFFFF26;
    selection:  #FFFFFF1F;

    font:       "Noto Sans 12";
    highlight:  bold #78AEED;
}

// ── WINDOW ──────────────────────────────────────────────────────────────────

window {
    transparency: "real";
    location: north;
    y-offset: 100;
    width: 710px;
    padding: 12px;
    background-color: @window-bg;
    border: 1px solid;
    border-color: @outline;
    border-radius: 12px;
}

// ── MAINBOX ─────────────────────────────────────────────────────────────────

mainbox {
    children: ["inputbar", "listview", "message"];
    spacing: 10px;
    margin: 0px;
    padding: 10px;
}

// ── INPUTBAR ────────────────────────────────────────────────────────────────

inputbar {
    children: ["entry"];
    spacing: 10px;
}

prompt {
    text-color: @fg-muted;
}

entry {
    placeholder: "  Digite para pesquisar...";
    placeholder-color: @fg-muted;
    text-color: @fg;
    background-color: @view-bg;
    padding: 8px;
    border: 2px;
    border-color: @accent;
    border-radius: 8px;
}

// ── LISTVIEW ────────────────────────────────────────────────────────────────

listview {
    columns: 1;
    lines: 6;
    fixed-height: false;
    fixed-columns: true;
    cycle: true;
    scrollbar: false;
    require-input: true;
    border: 0px solid;
}

// ── ELEMENT ─────────────────────────────────────────────────────────────────

element {
    orientation: horizontal;
    children: [ "element-icon", "element-text" ];
    spacing: 8px;
    margin: 0px;
    padding: 6px 10px;
    border: 0px solid;
    border-radius: 8px;
    background-color: transparent;
    text-color: @fg;
}

element-icon {
    size: 1.8em;
    vertical-align: 0.5;
    background-color: transparent;
}

element-text {
    expand: true;
    markup: true;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element normal.active,
element alternate.active {
    background-color: transparent;
    text-color: @accent;
}

element selected.normal,
element selected.active {
    background-color: @selection;
    text-color: @fg;
}

// ── MESSAGE ─────────────────────────────────────────────────────────────────

message,
error-message,
textbox {
    background-color: transparent;
    text-color: @fg;
    border: 0px solid;
}
