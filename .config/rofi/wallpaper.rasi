* {
    background-color: transparent;
    window-bg: #242424;
    card-bg: #333333;
    outline: #ffffff26;
    selection: #ffffff;
}

window {
    transparency: "real";
    location: north;
    y-offset: 100;
    width: 713px;
    padding: 12px;
    background-color: @window-bg;
    border: 1px;
    border-color: @outline;
    border-radius: 8px;
}

mainbox {
    children: ["listview"];
}

listview {
    layout: horizontal;
    lines: 4;
    spacing: 10px;
    scrollbar: false;
}

element {
    children: ["element-icon"];
    padding: 6px;
    background-color: @card-bg;
    border: 1px;
    border-color: transparent;
    border-radius: 8px;
}

element-icon {
    size: 150px;
}

element selected.normal {
    border-color: @selection;
}
