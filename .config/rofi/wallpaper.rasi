* {
    background-color: transparent;
    window-bg:  #242424ff;
    card-bg:    #333333ff;
    outline:    #ffffff26;
    selection:  #ffffffff;
}

window {
    transparency: "real";
    location: north;
    y-offset: 100;
    width: 713px;
    padding: 12px;
    background-color: @window-bg;
    border: 1px solid;
    border-color: @outline;
    border-radius: 8px;
}

mainbox {
    children: ["listview"];
    padding: 0px;
    spacing: 0px;
}

listview {
    layout: horizontal;
    lines: 4;
    spacing: 10px;
    padding: 0px;
    cycle: true;
    scrollbar: false;
    require-input: false;
    fixed-columns: true;
}

element {
    children: ["element-icon"];
    padding: 6px;
    background-color: @card-bg;
    border: 1px solid;
    border-color: transparent;
    border-radius: 8px;
}

element-icon {
    size: 150px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

element selected.normal {
    background-color: @card-bg;
    border-color: @selection;
}
