{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,

  "modules-left": [
    "niri/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "group/tray-drawer",
    "pulseaudio",
    "network",
    "custom/power"
  ],

  "niri/workspaces": {
    "format": "",
    "disable-scroll": true,
    "all-outputs": true
  },

  "clock": {
    "format": "{:L%a, %d de %B %H:%M}",
    "locale": "pt_BR.UTF-8",
    "tooltip": false
  },

  "group/tray-drawer": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "transition-left-to-right": true,
      "click-to-reveal": true
    },
    "modules": [
      "custom/tray-toggle",
      "tray"
    ]
  },

  "custom/tray-toggle": {
    "format": " ",
    "tooltip": false
  },

  "tray": {
    "icon-size": 16,
    "spacing": 12,
    "show-passive-items": true
  },

  "pulseaudio": {
    "format": " ",
    "format-muted": " ",
    "tooltip": false,
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": ":",
    "on-scroll-down": ":"
  },

  "network": {
    "format-wifi": " ",
    "format-ethernet": " ",
    "format-linked": " ",
    "format-disconnected": " ",
    "format-disabled": " ",
    "tooltip": false,
    "on-click": "nm-connection-editor"
  },

  "custom/power": {
    "format": " ",
    "tooltip": false,
    "on-click": "nwg-bar"
  }
}
