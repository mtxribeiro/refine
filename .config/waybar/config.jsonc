{
  // GLOBAL

  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 0,

  // MODULES

  "modules-left": [
    "niri/workspaces"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "group/status"
  ],

  // WORKSPACES

  "niri/workspaces": {
    "format": "",
    "disable-scroll": true,
    "all-outputs": true
  },

  // CLOCK

  "clock": {
    "format": "{:L%a %d de %B %H:%M}",
    "locale": "pt_BR.UTF-8",
    "tooltip": false
  },

  // STATUS GROUP

  "group/status": {
    "orientation": "horizontal",
    "modules": [
      "tray",
      "pulseaudio",
      "network"
    ]
  },

  // NETWORK

  "network": {
    "format-wifi": " ",
    "format-ethernet": " ",
    "format-linked": " ",
    "format-disconnected": " ",
    "format-disabled": " ",
    "tooltip": false,
    "on-click": "nm-connection-editor"
  },

  // VOLUME

  "pulseaudio": {
    "format": " ",
    "format-muted": " ",
    "tooltip": false,
    "on-click": "pavucontrol",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": ":",
    "on-scroll-down": ":"
  },

  // TRAY

  "tray": {
    "icon-size": 16,
    "spacing": 12,
    "show-passive-items": true
  }
}
